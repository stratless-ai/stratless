node_modules/
dist/
# `dist/` above matches a DIRECTORY. `nuxi generate` leaves web/dist as a SYMLINK to .output/public,
# and a symlink is a file to git — so the rule above misses it and it shows up as untracked after
# every site build. That is how it got committed in the first place: the symlink rode into the repo
# with the monorepo consolidation and pointed at an absolute path on one machine, which every
# stranger who cloned then got as a dangling link (removed in #60). Without this line, one
# `git add -A` after a build puts it straight back.
/web/dist
.nuxt/
.output/
.wrangler/
*.log
.DS_Store
package-lock.json


# scratch notes — personal working files, not repo content. Anchored to the root on purpose:
# a bare `docs/` would also ignore web/content/docs/ (the site docs) at any depth.
/docs/

# session tooling artifacts (exploration logs, local settings) — not repo content
/.claude/


# env files (can opt-in for committing if needed)
.env*